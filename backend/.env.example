APP_NAME=WasmBox Sandbox
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Postgres in production, e.g:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/wasmbox
# SQLite works for local development without a Postgres install:
DATABASE_URL=sqlite:///./wasmbox.db

SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins the frontend is served from.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Plugin sandbox resource limits.
SANDBOX_TIMEOUT_SECONDS=0.05
SANDBOX_STARTUP_GRACE_SECONDS=0.5
SANDBOX_CPU_SECONDS=5
SANDBOX_MEMORY_MB=128
WASM_FUEL_LIMIT=100000
